
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
# ============================================================
# BE6500 (jdcloud_re-cs-06) Kwrt 25.12 优化版 .config 追加段 v4 (2026-11-19)
# 追加到 kiddin9/Kwrt (分支 25.12) 的 devices/qualcommbe_ipq53xx/.config 末尾
# 基底已有: TARGET_qualcommbe/ipq53xx; common 已含 CONFIG_KERNEL_DEBUG_INFO_BTF=y
# v4 优化原则: 同类只留最强的、fw4 不兼容的砍掉、常驻内存大户砍掉、缺的补上
# 被砍的都以注释形式留在文末, 删掉行首 # 即可恢复
# ============================================================

CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_jdcloud_re-cs-06=y

# ---------- 代理 (二选一主用, 默认都不自启) ----------
# Nikki: 主力 mihomo (与你的 Sub-Store 覆写生态一致)
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_mihomo-meta=y
# Honk: eBPF 线 (内核 BTF 走 CONFIG_KERNEL_DEBUG_INFO_BTF=y 默认分支)
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-i18n-honk-zh-cn=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# ---------- 流量监控 (只留 bandix 一个) ----------
CONFIG_PACKAGE_bandix=y
CONFIG_PACKAGE_luci-app-bandix=y
CONFIG_PACKAGE_luci-i18n-bandix-zh-cn=y

# ---------- 访问控制 ----------
# oaf: 应用过滤 (最强的一个, 带按设备/时间的应用管控)
CONFIG_PACKAGE_luci-app-oaf=y
CONFIG_PACKAGE_kmod-oaf=y
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=y
# timecontrol: 简单上网时间窗 (源里无 luci-app-nft-timecontrol, 用此替代, 兼容 firewall4)
CONFIG_PACKAGE_luci-app-timecontrol=y
CONFIG_PACKAGE_luci-i18n-timecontrol-zh-cn=y

# ---------- IPTV (只留 rtp2httpd 一个转播核心 + igmpproxy 直通组播) ----------
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_igmpproxy=y

# ---------- 工具类 ----------
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y
CONFIG_PACKAGE_gately=y
CONFIG_PACKAGE_luci-app-gately=y
CONFIG_PACKAGE_luci-app-ap-modem=y
CONFIG_PACKAGE_fastnet=y
CONFIG_PACKAGE_luci-app-fastnet=y
CONFIG_PACKAGE_luci-app-taskplan=y
CONFIG_PACKAGE_luci-i18n-taskplan-zh-cn=y
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-i18n-cpufreq-zh-cn=y
CONFIG_PACKAGE_luci-app-fwlive=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# ---------- 主路由增强 (新增) ----------
# SQM: PPPoE 宽带抗 bufferbloat, 游戏/会议不被下载挤爆 (刷后在 LuCI 里填上下行速率)
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
# usteer: 与家里另一台 AP (RAX3000M, 已预置 k/v/r) 同 SSID 时做漫游引导, 比 easymesh 更对路
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_luci-app-usteer=y

# ---------- WireGuard ----------
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# ---------- 路由器灯控制 ----------
CONFIG_PACKAGE_luci-app-gpioled=y
CONFIG_PACKAGE_kmod-leds-gpio=y
# 注: 25.12 起 kmod-ledtrig-timer/netdev/heartbeat/default-on 包名已取消,
# 这四个触发器在 generic 6.18 内核配置里默认 =y 内建; netdev 触发另有继任包:
CONFIG_PACKAGE_kmod-ledtrig-network=y

# ============================================================
# v4 砍掉的 (同类重复 / 不兼容 / 大户), 要恢复删行首 # 即可:
# --- 流量监控四个留一: bandix 已覆盖按设备实时+统计 ---
#CONFIG_PACKAGE_luci-app-nlbwmon=y
#CONFIG_PACKAGE_wrtbwmon=y
#CONFIG_PACKAGE_luci-app-wrtbwmon=y
# --- netdata: 1G 内存机常驻大户, 系统图 LuCI 自带统计够用 ---
#CONFIG_PACKAGE_netdata=y
#CONFIG_PACKAGE_luci-app-netdata=y
# --- parentcontrol: 依赖旧 iptables 组件, fw4 下不可靠, 功能被 oaf+timecontrol 覆盖 ---
#CONFIG_PACKAGE_luci-app-parentcontrol=y
# --- msd_lite: 与 rtp2httpd 同为组播转 HTTP, 只留一个 ---
#CONFIG_PACKAGE_msd_lite=y
#CONFIG_PACKAGE_luci-app-msd_lite=y
# --- openclash: 第三个代理核心, 与 Nikki 同为 mihomo 同配置, 只会抢 DNS/防火墙 ---
#CONFIG_PACKAGE_luci-app-openclash=y
# --- easymesh: batman-adv 方案, 与你 RAX3000M 的 k/v/r 漫游不是一套, ath12k 上又是实验性质 ---
#CONFIG_PACKAGE_luci-app-easymesh=y
# --- unblockneteasemusic: 解锁成功率已大不如前, 还可能干扰网易云正常登录 ---
#CONFIG_PACKAGE_luci-app-unblockneteasemusic=y
#
# 可选项 (默认不开, 需要再启用):
# --- AdGuard Home 去广告: 与 Nikki/Honk 的 DNS 处理要协调, 开前先定 DNS 链路 ---
#CONFIG_PACKAGE_luci-app-adguardhome=y
# ============================================================
# 仍在的风险: kmod-oaf 是树外内核模块, 对 6.18 有编译失败风险; 若 Actions 红在 oaf,
# 把 luci-app-oaf 与 kmod-oaf 两行也注释掉重编, 其余不受影响。
# ============================================================
